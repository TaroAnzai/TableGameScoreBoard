{
  "expo": {
    "name": "mahjong-mobile",
    "slug": "mahjong-mobile",
    "scheme": "mahjongapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mahjong_icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anzaihome.mahjongapp",
      "associatedDomains": [
        "applinks:anzai-home.com",
        "applinks:anzai-home.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/mahjong_foreground.png",
        "backgroundImage": "./assets/mahjong_background.png",
        "monochromeImage": "./assets/mahjong_monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anzaihome.mahjongapp",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "anzai-home.com",
              "pathPrefix": "/mahjong"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/mahjong_favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-splash-screen"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8d9eb11b-19c2-460f-a3d2-d308a93b68c4"
      }
    }
  }
}
